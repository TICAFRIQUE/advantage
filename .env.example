APP_NAME=Advantage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://advantage.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Abidjan

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=advantage
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Plateforme ADVANTAGE ---
SUPERADMIN_NOM="Super Administrateur"
SUPERADMIN_NOM_UTILISATEUR=superadmin
SUPERADMIN_EMAIL=
# 12 caractères minimum. À retirer du .env après le premier déploiement.
SUPERADMIN_MOT_DE_PASSE=

# Générer avec : php -r 'echo "base64:".base64_encode(random_bytes(32));'
PLATEFORME_CLE_HMAC=

OTP_DUREE_MINUTES=5
OTP_TENTATIVES_MAX=3
CONNEXION_ECHECS_AVANT_VERROUILLAGE=10

SMS_DRIVER=simulation
SMS_EXPEDITEUR=ADVANTAGE
# Pilote « ticafrique » (production) : SMS_DRIVER=ticafrique
TICAFRIQUE_SMS_API_URL=https://sms.ticafrique.ci/api/v1/sms/send
TICAFRIQUE_SMS_API_KEY=
TICAFRIQUE_SMS_SENDER_ID=
# TICAFRIQUE_SMS_TIMEOUT=10

# Alertes d'expiration par SMS (3, 2 et 1 mois avant l'échéance)
ALERTES_EXPIRATION_SMS=true
ALERTES_EXPIRATION_HEURE=09:00

# Pays par défaut des numéros de téléphone
TELEPHONE_PAYS_DEFAUT=CI

# Rétention des codes de validation et des SMS (jours)
RETENTION_DEMANDES_OTP_JOURS=90
RETENTION_MESSAGES_SMS_JOURS=90

# Sauvegardes (dossier hors de public/, idéalement hors du projet)
# SAUVEGARDES_DOSSIER=/home/compte/sauvegardes-advantage
SAUVEGARDES_CONSERVER=10
SAUVEGARDES_AUTOMATIQUE=true
# SAUVEGARDES_MYSQLDUMP=/usr/bin/mysqldump
# SAUVEGARDES_MYSQL=/usr/bin/mysql

# Nombre maximal de lignes par export
EXPORT_LIGNES_MAX_TABLEUR=100000
EXPORT_LIGNES_MAX_PDF=2000

# Durée de conservation du journal d audit (jours). Purge quotidienne automatique.
JOURNAL_AUDIT_RETENTION_JOURS=14

# Limite de tentatives de connexion par IP et par minute (large à cause du CGNAT mobile).
CONNEXION_TENTATIVES_PAR_IP=60

# Proxys de confiance (IP/CIDR séparées par des virgules). Vide = aucun.
# À renseigner si l'application est derrière Cloudflare / un répartiteur de charge.
TRUSTED_PROXIES=

# Outil de développement : journal navigateur désactivé (incompatible avec la CSP)
BOOST_BROWSER_LOGS_WATCHER=false
